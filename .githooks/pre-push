#!/usr/bin/env bash
# Runs tests before every push (rule 7). Enabled by scripts/setup-dev.sh.
set -euo pipefail

if [ "${SKIP_TESTS:-0}" = "1" ]; then
  echo "SKIP_TESTS=1 set - skipping local tests."
  exit 0
fi

root=$(git rev-parse --show-toplevel)
cd "$root"

status=0

if [ -f backend/pom.xml ]; then
  backend_dir=backend
elif [ -f pom.xml ]; then
  backend_dir=.
else
  backend_dir=
fi

if [ -n "$backend_dir" ]; then
  echo "Running backend tests in ${backend_dir} ..."
  if [ -x "$backend_dir/mvnw" ]; then
    (cd "$backend_dir" && ./mvnw -B -q test) || status=1
  else
    (cd "$backend_dir" && mvn -B -q test) || status=1
  fi
else
  echo "No Maven backend detected - skipping backend tests."
fi

if [ -f frontend/package.json ]; then
  if [ -d frontend/node_modules ]; then
    echo "Running frontend tests ..."
    (cd frontend && CI=true npm test --if-present) || status=1
  else
    echo "frontend/node_modules is missing - run 'npm ci' in frontend to enable local tests."
  fi
else
  echo "No frontend detected - skipping frontend tests."
fi

if [ "$status" -ne 0 ]; then
  echo ""
  echo "Push blocked: local tests failed. Fix the tests before pushing."
  exit 1
fi

echo "Local tests passed."
