{
  "info": {
    "name": "OTMS System Validation",
    "description": "System Validation Report collection (Deliverables Part-3 2b ii). Run against a live backend freshly booted with seed data (DataInitializer seeds on every boot). Maps to SRS acceptance test cases; Sprint-3 additions cover role guards (TC-SEC-02), theatre availability (TC-RES-04), equipment availability and maintenance (TC-RES-03/05), emergency impact/reschedule (TC-EMG-03/04), notifications (TC-NOT-01/02) and report data (TC-REP-01).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC-Auth-01 Login with valid credentials",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('returns 200 with JWT token', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.token).to.be.a('string').that.is.not.empty;",
              "  pm.collectionVariables.set('token', body.token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"admin@otms.local\",\"password\":\"Admin123!\"}"
        }
      }
    },
