    {
      "name": "TC-SURG-01 Create a valid surgery",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const pad = function (n) { return String(n).padStart(2, '0'); };",
              "const dayAt = function (offsetDays, h, m) {",
              "  const d = new Date();",
              "  d.setDate(d.getDate() + offsetDays);",
              "  d.setHours(h, m, 0, 0);",
              "  return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());",
              "};",
              "pm.collectionVariables.set('createStart', dayAt(0, 8, 0));",
              "pm.collectionVariables.set('createEnd', dayAt(0, 9, 0));"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('returns 201 or 200 with created surgery', function () {",
              "  pm.expect([200, 201]).to.include(pm.response.code);",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eq('SCHEDULED');",
              "  pm.collectionVariables.set('surgeryId', body.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/surgeries",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "surgeries"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"patientName\":\"Postman Validation\",\"procedureName\":\"Validation cholecystectomy\",\"theatreId\":{{ot3Id}},\"leadSurgeonId\":{{drRamId}},\"startTime\":\"{{createStart}}\",\"endTime\":\"{{createEnd}}\",\"emergency\":false}"
        }
      }
    },
